# ── Supabase (agentes, clientes, boards, cérebro — ver supabase/migrations/) ──
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Compartilhado entre agentes (usado como fallback quando o agente não tem override) ──
ANTHROPIC_API_KEY=
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# Protege o endpoint /api/cron/monitor
CRON_SECRET=

# ── Por agente ──────────────────────────────────────────────────────
# Prefixo = id do agente em maiúsculo (o id cadastrado na tabela public.agents)
# Repita este bloco para cada agente novo. management_phones agora vem do banco
# (coluna agents.management_phones) — só as credenciais externas ficam em env var.

