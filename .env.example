# ── Supabase (agentes, clientes, boards, cérebro — ver supabase/migrations/) ──
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ── Compartilhado entre agentes (usado como fallback quando o agente não tem override) ──
ANTHROPIC_API_KEY=
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# Protege o endpoint /api/cron/monitor
CRON_SECRET=

# ── Por agente ──────────────────────────────────────────────────────
# Prefixo = id do agente em maiúsculo (o id cadastrado na tabela public.agents)
# Repita este bloco para cada agente novo. Telefones de gestão NÃO ficam aqui —
# são extraídos direto do texto do cérebro (tabela brains), editável no painel.
# Cada tenant (AM, ANSER...) pode ter integrações e credenciais próprias e
# diferentes (ex.: AM usa Trello, ANSER usa Nibo) — configure só o que esse
# agente/tenant realmente usa.

# GESTAO_MARKETING_ZAPI_BASE_URL=https://api.z-api.io
# GESTAO_MARKETING_ZAPI_INSTANCE_ID=
# GESTAO_MARKETING_ZAPI_TOKEN=
# GESTAO_MARKETING_ZAPI_CLIENT_TOKEN=
# GESTAO_MARKETING_TRELLO_API_KEY=
# GESTAO_MARKETING_TRELLO_API_TOKEN=
